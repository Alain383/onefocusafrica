// Prisma schema for ONEFOCUS AFRICA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Inquiry {
  id          String   @id @default(uuid())
  fullName    String
  workEmail   String
  company     String?
  industry    String?
  country     String?
  website     String?
  serviceArea String   // Brand, Cinematic, Web, Corporate, Talent
  challenge   String   
  objective   String?  
  timeline    String?
  consent     Boolean  @default(false)
  status      String   @default("new") // new, contacted, qualified, proposal, closed
  source      String   @default("website") // website, referral, etc
  assignedTo   String?
  notes        String?
  followUpDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CommunityMember {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  whatsappPhone String?
  membershipFee Float    @default(2.00)
  paymentStatus String   @default("pending") // pending, completed
  interests     String // Array of interest areas
  joinedAt      DateTime @default(now())
  isActive      Boolean  @default(true)

  @@index([email])
  @@index([paymentStatus])
}

model NewsletterSubscriber {
  id          String   @id @default(uuid())
  email       String   @unique
  subscribedAt DateTime @default(now())
  isActive    Boolean  @default(true)
}

model CaseStudy {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  category      String   // Brand, Media, Web, Training
  clientName    String?
  challenge     String   
  solution      String   
  deliverables  String // Array of deliverables
  outcome       String   
  publishedAssets String // URLs or paths
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}



enum AdminRole {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum ProgramStatus {
  active
  inactive
}

enum EventStatus {
  upcoming
  past
  cancelled
}

model AdminUser {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  hashedPassword String
  role           AdminRole @default(EDITOR)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  posts          Post[]
  mediaAssets    MediaAsset[]
  siteContents   SiteContent[]

  @@index([email])
  @@index([role])
}

model Post {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  content        String     
  excerpt        String?    
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  authorId       String
  author         AdminUser  @relation(fields: [authorId], references: [id])
  categories     PostCategory[] @relation("PostToCategory")
  tags           PostTag[]      @relation("PostToTag")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
}

model PostCategory {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToCategory")

  @@index([slug])
}

model PostTag {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")
}

model MediaAsset {
  id            String    @id @default(uuid())
  filename      String
  originalName  String
  url           String
  mimeType      String
  size          Int
  uploadedById  String
  uploadedBy    AdminUser @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([uploadedById])
  @@index([mimeType])
}

model SiteContent {
  id          String    @id @default(uuid())
  section     String
  key         String
  value       String    
  updatedById String
  updatedBy   AdminUser @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt

  @@unique([section, key])
  @@index([section])
}

model Program {
  id          String        @id @default(uuid())
  title       String
  description String        
  icon        String?
  status      ProgramStatus @default(active)
  urlAnchor   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Event {
  id               String      @id @default(uuid())
  title            String
  description      String      
  eventDate        DateTime
  location         String?
  status           EventStatus @default(upcoming)
  registrationLink String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([eventDate])
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  roleTitle String
  bio       String?  
  photo     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

