// Prisma schema for ONEFOCUS AFRICA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id          String   @id @default(uuid())
  fullName    String
  workEmail   String
  company     String?
  industry    String?
  country     String?
  website     String?
  serviceArea String   // Brand, Cinematic, Web, Corporate, Talent
  challenge   String   @db.Text
  objective   String?  @db.Text
  timeline    String?
  consent     Boolean  @default(false)
  status      String   @default("new") // new, contacted, qualified, proposal, closed
  source      String   @default("website") // website, referral, etc
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CommunityMember {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  whatsappPhone String?
  membershipFee Float    @default(2.00)
  paymentStatus String   @default("pending") // pending, completed
  interests     String[] // Array of interest areas
  joinedAt      DateTime @default(now())
  isActive      Boolean  @default(true)

  @@index([email])
  @@index([paymentStatus])
}

model NewsletterSubscriber {
  id          String   @id @default(uuid())
  email       String   @unique
  subscribedAt DateTime @default(now())
  isActive    Boolean  @default(true)
}

model CaseStudy {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  category      String   // Brand, Media, Web, Training
  clientName    String?
  challenge     String   @db.Text
  solution      String   @db.Text
  deliverables  String[] // Array of deliverables
  outcome       String   @db.Text
  publishedAssets String[] // URLs or paths
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}
