# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Monorepo workspace dependencies
apps/*/node_modules
packages/*/node_modules

# testing
/coverage
apps/*/coverage
packages/*/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/

# production
/build
apps/*/build
packages/*/dist
packages/*/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (CRITICAL - Never commit these)
.env
.env*
.env*.local
apps/*/.env
apps/*/.env*
apps/*/.env*.local
packages/*/.env
packages/*/.env*.local

# vercel
.vercel
apps/*/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/*/next-env.d.ts

# prisma
/prisma/migrations
packages/database/prisma/migrations

# SQLite databases (local development - NEVER commit)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
prisma/prisma/*.db
prisma/prisma/*.db-*
prisma/*.db
prisma/*.db-*

# Uploaded media files (local development)
/public/uploads/*
!/public/uploads/.gitkeep
apps/*/public/uploads/*
!apps/*/public/uploads/.gitkeep

# Backup files
*.backup
*.backup-*
*.original
*.old
*.bak

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store

# Scripts (may contain sensitive paths or configs)
*.ps1
!.kiro/**/*.ps1

# Kiro temporary files
.kiro/temp/
.kiro/cache/
.neon

# Build and install logs
*.txt
!README.txt
